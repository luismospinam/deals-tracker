# Secrets — MUST stay out of history.
# local.properties holds the MercadoLibre client secret.
# .env holds the Postgres password.
local.properties
.env
*.local

# Gradle / build
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
# Kotlin compiler daemon's session state (Kotlin 2.x), written next to the build.
.kotlin/

# Persistent Chrome profile used by the assisted Amazon check. Holds real Amazon
# cookies -- and a logged-in session if the operator signs in. Never commit.
.amazon-profile/

# Runtime state
logs/
*.log
.ml-token.json

# Claude Code local state. worktrees/ holds real git worktrees and must never be
# committed; settings.local.json is per-machine. A shared .claude/settings.json could be
# tracked later by un-ignoring it explicitly.
.claude/worktrees/
.claude/settings.local.json

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# macOS
.DS_Store

# Lavish Editor review artifacts (scratch, not part of the app)
.lavish/

# Editor state. settings.json is shared -- it enables the plugins this repo expects --
# but permission grants and worktrees are per-machine.
.claude/settings.local.json
.claude/worktrees/
