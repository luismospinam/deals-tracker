# Copy to .env and set a real password. .env is gitignored.
POSTGRES_DB=deals
POSTGRES_USER=deals
POSTGRES_PASSWORD=change-me

# Discord webhooks for the daily "pinned items on sale" posts, one channel per section. Optional:
# a section with no URL is simply not posted. Channel settings > Integrations > Webhooks > Copy URL.
DISCORD_GROCERIES_WEBHOOK_URL=
DISCORD_TRACKED_WEBHOOK_URL=
# The daily watch-alert digest (defaults.watchDigestTimes), every watch in one post, biggest gap first.
DISCORD_WATCHES_WEBHOOK_URL=
# Source-health and backup alerts (a source returning nothing several runs in a row, a failed dump).
# Optional: unset, they go to the watch digest's channel above, and always to a desktop banner.
DISCORD_HEALTH_WEBHOOK_URL=
